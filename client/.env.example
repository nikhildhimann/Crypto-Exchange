# Local development
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3000
VITE_DEV_API_PROXY_TARGET=http://localhost:6001
VITE_HMR_HOST=
VITE_HMR_CLIENT_PORT=3000
VITE_HMR_PROTOCOL=ws

# Public backend URLs
VITE_API_BASE_URL=https://your-render-api.onrender.com/api
VITE_SOCKET_URL=https://your-render-api.onrender.com
VITE_APP_VERSION=web

# Wallet provisioning
VITE_WALLET_PROVISIONING_SCOPE=primary

# API client behavior
VITE_API_REQUEST_TIMEOUT_MS=15000
VITE_API_RETRY_MAX_ATTEMPTS=2
VITE_API_RETRY_BASE_DELAY_MS=500

# Demo-safe refresh and polling intervals
VITE_BALANCE_REFRESH_INTERVAL_MS=60000
VITE_NOTIFICATION_REFRESH_INTERVAL_MS=60000
VITE_MARKET_PRICE_REFRESH_INTERVAL_MS=180000
VITE_NFT_SYNC_STATUS_POLL_INTERVAL_MS=15000
VITE_PENDING_SWAP_REFRESH_INTERVAL_MS=30000
VITE_SWAP_STATUS_POLL_INTERVAL_MS=30000
VITE_SOCKET_RECONNECT_ATTEMPTS=3
VITE_SOCKET_RECONNECT_DELAY_MS=10000

# Conversion UI polling
VITE_CONVERSION_PREVIEW_DEBOUNCE_MS=600
VITE_CONVERSION_POLL_INTERVAL_MS=30000
VITE_CONVERSION_POLL_TIMEOUT_MS=600000
VITE_CONVERSION_PREVIEW_RETRY_MAX_ATTEMPTS=2
VITE_CONVERSION_CREATE_RETRY_MAX_ATTEMPTS=2
VITE_CONVERSION_POLL_RETRY_MAX_ATTEMPTS=2
VITE_CONVERSION_RETRY_BASE_DELAY_MS=750
VITE_CONVERSION_DISPLAY_SLIPPAGE_LABEL=Indicative
