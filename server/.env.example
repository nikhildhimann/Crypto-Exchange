# Core app
DEMO_MODE=true
APP_NAME=Crypto Wallet
NODE_ENV=production
PORT=6001
API_PREFIX=/api
BODY_LIMIT=1mb
MAX_QUERY_STRING_LENGTH=2000
QUERY_TIMEOUT_MS=30000
REQUEST_LOGGING_ENABLED=false
DEFAULT_CHAIN=xrp
MAINNET_ONLY=true
QUEUE_ENABLED=false
TRANSACTION_PREVIEW_EXPIRY_SECONDS=300

# Frontend allowlists
CORS_ORIGIN=https://your-vercel-app.vercel.app
SOCKET_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
SOCKET_ALLOW_CREDENTIALS=true

# Auth and encryption
JWT_SECRET=replace_with_64_plus_random_chars
SUPERADMIN_JWT_SECRET=replace_with_different_64_plus_random_chars
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=604800000
SESSION_INACTIVITY_TIMEOUT_MS=86400000
JWT_ISSUER=wallet-api
JWT_AUDIENCE_USER=wallet-user
JWT_AUDIENCE_SUPERADMIN=wallet-superadmin
BCRYPT_SALT_ROUNDS=10
ENCRYPTION_KEY=replace_with_64_plus_random_chars
AES_SECRET_KEY_BASE64=
ENCRYPTION_KEY_BASE64=

# Database and cache
DB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_URL=
REDIS_PREFIX=walletapp
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_REQUIRED_IN_PRODUCTION=false

# Security headers
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Webhooks
TRON_WEBHOOK_SECRET=
BTC_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE=300

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
SUPERADMIN_AUTH_RATE_LIMIT_WINDOW_MS=60000
SUPERADMIN_AUTH_RATE_LIMIT_MAX_REQUESTS=10
TRANSACTION_RATE_LIMIT_WINDOW_MS=60000
TRANSACTION_RATE_LIMIT_MAX_REQUESTS=30
WALLET_MUTATION_RATE_LIMIT_WINDOW_MS=60000
WALLET_MUTATION_RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MS=900000

# Superadmin bootstrap
SUPERADMIN_BOOTSTRAP_EMAIL=admin@example.com
SUPERADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_temporary_password
SUPERADMIN_BOOTSTRAP_ROLE=superadmin
SUPERADMIN_BOOTSTRAP_ROTATE_PASSWORD=true
SUPERADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
SUPERADMIN_REFRESH_TOKEN_TTL_MS=604800000
SUPERADMIN_MAX_CONCURRENT_SESSIONS=3

# Withdrawal risk controls
WITHDRAWAL_MAX_PER_TX=1000
WITHDRAWAL_MAX_PER_HOUR=5000
WITHDRAWAL_MAX_PER_DAY=20000
WITHDRAWAL_MAX_COUNT_PER_HOUR=10
WITHDRAWAL_MAX_COUNT_PER_DAY=50
WITHDRAWAL_NEW_DESTINATION_COOLDOWN_MINUTES=60
WITHDRAWAL_NEW_DESTINATION_REQUIRE_REVIEW=true
WITHDRAWAL_REVIEW_HIGH_AMOUNT=1000
WITHDRAWAL_BLOCK_ON_RISK=true
WITHDRAWAL_REQUIRE_REVIEW_ON_NEW_DESTINATION=true
WITHDRAWAL_FEE_BPS=0
DEPOSIT_FEE_BPS=0

# Captcha
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_TIMEOUT_MS=5000
CAPTCHA_ENFORCE_ON_AUTH=false
CAPTCHA_ENFORCE_ON_ANON_SESSION=false
CAPTCHA_ENFORCE_ON_WALLET_IMPORT=false

# Treasury and fees
TREASURY_HOT_WALLET_THRESHOLD=0
TREASURY_AUTO_SWEEP_ENABLED=false
TREASURY_RECONCILE_INTERVAL_MINUTES=30
TREASURY_RECONCILE_ENABLED=false
TREASURY_ADDRESSES=
SYSTEM_FEE_ENABLED=false
PLATFORM_FEE_ENABLED=false
PLATFORM_FEE_TYPE=fixed
PLATFORM_FEE_VALUE=0
SYSTEM_WALLET_ADDRESS=
SYSTEM_WALLET_SECRET=

# Background jobs for free demo hosting
JOBS_ENABLED=false
DEPOSIT_WATCHER_ENABLED=false
DEPOSIT_WATCHER_INTERVAL_MS=30000
WITHDRAWAL_STATUS_ENABLED=false
WITHDRAWAL_STATUS_INTERVAL_MS=60000
TRANSACTION_STATUS_ENABLED=false
TRANSACTION_STATUS_INTERVAL_MS=60000
BALANCE_SYNC_ENABLED=false
BALANCE_SYNC_INTERVAL_MS=300000
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_INTERVAL_MS=3600000
TREASURY_RECONCILE_ENABLED=false
TREASURY_RECONCILE_INTERVAL_MS=86400000
UTXO_WALLET_SYNC_ENABLED=false
UTXO_WALLET_SYNC_INTERVAL_MS=180000
SYNC_QUEUE_WORKER_ENABLED=false
SYNC_QUEUE_WORKER_INTERVAL_MS=15000
NFT_LISTING_EXPIRY_ENABLED=true
NFT_LISTING_EXPIRY_INTERVAL_MS=600000
NFT_HISTORY_SYNC_ENABLED=false
NFT_RECONCILIATION_ENABLED=false
NFT_RECONCILIATION_INTERVAL_MS=300000
NFT_RECONCILIATION_BATCH_LIMIT=25
UTXO_WALLET_SYNC_BATCH_SIZE=10
UTXO_WALLET_SYNC_BATCH_DELAY_MS=2000
UTXO_WALLET_SYNC_MAX_WALLETS=50

# Wallet provisioning
OPERATIONS_PROVISIONING_CONCURRENCY=2
OPERATIONS_MARKET_PRICE_CACHE_TTL_MS=300000
OPERATIONS_BALANCE_SYNC_COOLDOWN_MS=60000
OPERATIONS_BALANCE_LIST_CACHE_TTL_MS=60000
WALLET_AUTO_PROVISION_DEFAULT_SCOPE=primary
WALLET_AUTO_PROVISION_CHAINS=

# Conversion module
CONVERSION_MODULE_ENABLED=true
CONVERSION_PRICING_MODE=indicative_final_on_deposit
CONVERSION_QUOTE_TTL_MS=60000
CONVERSION_DEFAULT_SPREAD_BPS=150
CONVERSION_SOURCE_DEPOSIT_DEFAULT_CONFIRMATIONS=1
CONVERSION_SOURCE_DEPOSIT_AMOUNT_TOLERANCE_MODE=absolute
CONVERSION_SOURCE_DEPOSIT_AMOUNT_TOLERANCE_DEFAULT=0
CONVERSION_SOURCE_DEPOSIT_AMBIGUITY_POLICY=manual_review
CONVERSION_DEPOSIT_MATCHING_ENABLED=false
CONVERSION_TREASURY_INSUFFICIENCY_POLICY=manual_review
CONVERSION_SETTLEMENT_PREPARATION_ENABLED=false
CONVERSION_PAYOUT_EXECUTION_ENABLED=false
CONVERSION_PAYOUT_DRY_RUN=true
CONVERSION_PAYOUT_CONFIRMATION_ENABLED=false
CONVERSION_WORKER_ENABLED=false
CONVERSION_WORKER_INTERVAL_MS=15000
CONVERSION_WORKER_BATCH_SIZE=10
CONVERSION_WORKER_MAX_RETRY_ATTEMPTS=3
CONVERSION_WORKER_RETRY_BASE_DELAY_MS=1000
CONVERSION_PAYOUT_NETWORK_FEE_ESTIMATION_STRATEGY=default
CONVERSION_PAYOUT_NETWORK_FEE_DEFAULT_ESTIMATE=0
CONVERSION_PAYOUT_NETWORK_FEE_PER_CHAIN_ESTIMATES=
CONVERSION_PAYOUT_NETWORK_FEE_PER_ASSET_ESTIMATES=
CONVERSION_PAYOUT_NETWORK_FEE_PER_PAIR_ESTIMATES=

# NFT marketplace
NFT_MARKETPLACE_DEFAULT_CHAIN=polygon
NFT_MARKETPLACE_ENABLED=false
NFT_MARKETPLACE_SUPPORTED_CHAINS=polygon
NFT_LISTING_MIN_PRICE_MATIC=0.001
NFT_LISTING_MAX_PRICE_MATIC=100000
NFT_LISTING_DEFAULT_EXPIRY_DAYS=7
NFT_BUY_MAX_PRICE_FLOOR_MULTIPLIER=3
SEAPORT_CONTRACT_ADDRESS=
OPENSEA_CONDUIT_KEY=
OPENSEA_API_KEY=
OPENSEA_BASE_URL=https://api.opensea.io/api/v2
ALCHEMY_API_KEY=
ALCHEMY_POLYGON_BASE_URL=
ALCHEMY_POLYGON_NFT_BASE_URL=
ALCHEMY_NFT_MAX_PAGES=3
NFT_PAGE_SIZE=25
NFT_SYNC_TTL_SECONDS=300

# Market and swap
MARKET_STATIC_FALLBACK_PRICES=
SWAP_ENABLED=false
SWAP_PREVIEW_TTL_SECONDS=60
SWAP_SPREAD_BPS=150
SWAP_SERVICE_FEE_BPS=0
SWAP_PAYOUT_FEE_BUFFER_BPS=0
SWAP_MIN_USD_EQUIVALENT=1
SWAP_MAX_USD_EQUIVALENT=1000
SWAP_MIN_PROFIT_USD=0
SWAP_ROUTE_RULES=
SWAP_SYSTEM_WALLETS=
PLATFORM_TRANSFER_SETTLEMENT_MODE=manual
BACKFILL_DRY_RUN=true

# XRP
XRPL_DEFAULT_NETWORK=mainnet
XRPL_MAINNET_URL=wss://your-xrpl-mainnet-url
XRPL_TESTNET_URL=wss://your-xrpl-testnet-url

# Solana
SOLANA_DEFAULT_NETWORK=mainnet
SOLANA_MAINNET_URL=https://your-solana-mainnet-rpc
SOLANA_TESTNET_URL=https://your-solana-testnet-rpc
SOLANA_COMMITMENT=confirmed
SOLANA_RPC_MAX_ATTEMPTS=2
SOLANA_RPC_BASE_DELAY_MS=500
SOLANA_HISTORY_BATCH_SIZE=10

# BNB
BNB_CHAIN_ID=56
BNB_RPC_HTTP=https://your-bnb-http-rpc
BNB_RPC_WSS=
BNB_EXPLORER_API_URL=https://your-bnb-explorer-api
